(footprint "PMS5003_Adapter_Socket_1x08"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "1x8 2.54 mm socket for a PMS5003 adapter board, which turns the sensor's 1.25 mm cable into a 1x8 2.54 mm header. Pins follow the sensor: VCC GND SET RX TX RST NC NC (RX and TX from the sensor's side). The adapter lies flat on either side of the socket; the courtyard keeps about 10 mm clear on both sides, estimated from a photo of a 22 x 10 mm adapter.")
	(tags "PMS5003 PMS7003 Plantower adapter socket 2.54mm")
