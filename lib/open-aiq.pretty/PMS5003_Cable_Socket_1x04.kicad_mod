(footprint "PMS5003_Cable_Socket_1x04"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "1x4 2.54 mm socket for a PMS5003 on a 4-wire cable or adapter. Pins follow the cable: TX RX VCC GND (TX and RX from the sensor's side), so pin 1 (TX) goes to the ESP32's RX. SET and RESET aren't wired; the sensor sleeps and wakes by UART command. The courtyard keeps about 10 mm clear on both sides so an adapter can lie flat.")
	(tags "PMS5003 PMS7003 Plantower 4-pin cable socket 2.54mm")
